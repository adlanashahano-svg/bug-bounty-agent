Bug Bounty Agent — первая версия
# Только для разрешённого тестирования

def показать_цель():
    print("=" * 50)
    print("      BUG BOUNTY AGENT")
    print("=" * 50)

    название = input("Название программы: ")
    адрес = input("URL разрешённой цели: ")
    разрешение = input("Тестирование официально разрешено? (да/нет): ")

    print("\n--- ПРОВЕРКА ---")

    if разрешение.lower() != "да":
        print("Остановлено: нет подтверждения разрешения.")  
        return

    print(f"Цель: {название}")
    print(f"URL: {адрес}")
    print("Статус: разрешение подтверждено пользователем")
    print("\nСледующий модуль: анализ scope и платежной логики.")


if __name__ == "__main__":
    показать_цель
